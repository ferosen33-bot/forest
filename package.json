{
  "name": "forest-survival",
  "version": "0.1.0",
  "description": "Browserbasiertes 3D-Survival-Game (Three.js + Rapier)",
  "author": "Wildwood",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "app": "vite build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferosen33-bot/forest.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ferosen33-bot/forest/issues"
  },
  "homepage": "https://github.com/ferosen33-bot/forest#readme",
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@pmndrs/assets": "^1.7.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "simplex-noise": "^4.0.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "@types/three": "^0.186.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "build": {
    "appId": "de.wildwood.game",
    "productName": "Wildwood",
    "copyright": "Wildwood",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wildwood",
      "artifactName": "Wildwood-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Wildwood-${version}-portable.exe"
    },
    "linux": {
      "target": "dir",
      "icon": "build/icon.png"
    }
  }
}
